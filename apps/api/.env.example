# Configuration de l'API (toutes les valeurs ont un défaut adapté au développement local)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://treso_app:treso_app@localhost:5432/treso
DATABASE_OWNER_URL=postgres://treso_owner:treso@localhost:5432/treso
APP_DB_ROLE=treso_app
JWT_SECRET=remplacez-par-une-valeur-secrete-de-32-caracteres-minimum
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
EXPOSE_EMAIL_LINKS=true

# Agrégateur bancaire Bridge (https://bridgeapi.io) : sans ces deux valeurs,
# seule la banque de démonstration est proposée.
# BRIDGE_CLIENT_ID=
# BRIDGE_CLIENT_SECRET=
# BRIDGE_BASE_URL=https://api.bridgeapi.io
# BRIDGE_VERSION=2025-01-15

# Envoi des emails (obligatoire en production). Messagerie OVH :
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_USER=no-reply@optimumgestion.fr
# SMTP_PASS=
# SMTP_FROM=Tréso Optimum <no-reply@optimumgestion.fr>

# Domaines autorisés à créer un compte sans invitation (vide = ouvert à tous)
# SIGNUP_ALLOWED_DOMAINS=optimumgestion.fr,groupe-jba.fr
