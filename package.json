{
  "name": "treso-optimum",
  "private": true,
  "version": "0.1.0",
  "description": "Tréso Optimum — logiciel de pilotage de trésorerie pour TPE/PME",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @optimum/api --filter @optimum/web dev",
    "dev:web": "pnpm --filter @optimum/web dev",
    "dev:api": "pnpm --filter @optimum/api dev",
    "db:migrate": "pnpm --filter @optimum/api migrate",
    "build": "pnpm -r typecheck && pnpm --filter @optimum/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
